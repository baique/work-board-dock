{
  "name": "workboard-dock",
  "productName": "tiptip",
  "version": "0.1.0",
  "description": "TIP — 智能体会话状态指示器 + 待办（独立置顶小窗）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:tauri": "tauri build",
    "build:frontend:tauri": "vite build --config vite.config.tauri.ts",
    "dev:web": "vite --config vite.config.tauri.ts --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "bun run typecheck:web && bun run typecheck:test",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "2.11.0",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.6"
  }
}
